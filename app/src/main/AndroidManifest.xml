<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Сканирование партии движком идёт в foreground service (см.
        GameAnalysisService): обычная корутина умерла бы, стоит пользователю
        свернуть приложение посреди минуты-двух разбора.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Установка скачанного обновления: без него система отклонит APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ChessCoach"
        android:extractNativeLibs="true">

        <!--
            singleTask нужен для возврата из браузера после входа в Lichess:
            система доставит ссылку уже работающему экрану через onNewIntent,
            а не создаст вторую копию приложения поверх первой.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Адрес возврата, объявленный при запросе авторизации. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.chesscoach.app" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <!--
            Снимок для разбора по фото берётся в полном разрешении, а для этого
            камере нужно отдать адрес файла. Превью, которое отдаёт камера без
            файла, слишком мелкое: на нём клетка настоящей доски занимает
            несколько десятков пикселей, и силуэт фигуры по ним не разобрать.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!--
            android:foregroundServiceType обязателен начиная с API 34 — без
            него сервис падает прямо при вызове startForeground.
        -->
        <service
            android:name=".analysis.GameAnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
