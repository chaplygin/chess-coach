<?xml version="1.0" encoding="utf-8"?>
<!--
    Единственные папки, которые приложение открывает наружу: временные снимки
    для камеры и скачанное обновление для установщика, обе в собственном кэше.
    Ничего больше отдавать не нужно, а широкий путь означал бы доступ стороннего
    приложения к данным аккаунта Lichess.
-->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="updates" path="updates/" />
</paths>
